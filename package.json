{
  "name": "diagram-tool",
  "version": "0.1.1",
  "type": "module",
  "bin": {
    "diagram-tool": "./dist/cli.js"
  },
  "files": [
    "dist",
    "libraries"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json && node src/viewer/build.mjs",
    "build:viewer": "node src/viewer/build.mjs",
    "prepublishOnly": "tsc -p tsconfig.json && node src/viewer/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@excalidraw/mermaid-to-excalidraw": "2.2.2",
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.5",
    "jsdom": "30.0.1",
    "mermaid": "11.17.2"
  },
  "devDependencies": {
    "@excalidraw/excalidraw": "0.18.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.28.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
